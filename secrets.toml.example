# Copie este arquivo para .streamlit/secrets.toml (uso local) ou cole o conteúdo em
# Settings > Secrets do app no Streamlit Community Cloud. Nunca suba o secrets.toml pro GitHub.

# Chave gratuita: https://aistudio.google.com/app/apikey
GEMINI_API_KEY = "cole-sua-chave-aqui"

# Opcionais
# GEMINI_MODEL = "gemini-flash-latest"  # padrão. Para respostas melhores (mais lento e mais caro): "gemini-pro-latest"
# FIPE_TOKEN = ""                       # token gratuito da API FIPE, aumenta o limite diário
# ADMIN_PASSWORD = ""                   # define uma senha pra ativar a página Admin (avisos técnicos das buscas)
